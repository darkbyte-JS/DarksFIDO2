<UserControl x:Class="DarksFIDO2.App.Controls.PinBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <Border Background="{DynamicResource WellBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="8" Height="38">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Prepended Icon Box -->
            <Border Grid.Column="0" Width="36" Background="Transparent" VerticalAlignment="Center">
                <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextSecondaryBrush}"
                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Password masked box -->
            <PasswordBox Grid.Column="1" x:Name="MaskedBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentPrimaryBrush}"
                         BorderThickness="0" Padding="4,6,12,6" VerticalAlignment="Center"
                         FontFamily="{StaticResource FontMonospace}" FontSize="14" />

            <!-- Revealed plaintext box -->
            <TextBox Grid.Column="1" x:Name="PlainBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource AccentPrimaryBrush}"
                     BorderThickness="0" Padding="4,6,12,6" VerticalAlignment="Center" Visibility="Collapsed"
                     FontFamily="{StaticResource FontMonospace}" FontSize="14" />

            <!-- Eye Toggle Button -->
            <Button x:Name="ToggleBtn" Grid.Column="2" Width="36" Height="34" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,2,0">
                <Path x:Name="ToggleIcon" Data="{StaticResource IconEye}" Fill="{DynamicResource TextSecondaryBrush}"
                      Width="16" Height="16" Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</UserControl>
