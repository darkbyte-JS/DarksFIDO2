<UserControl x:Class="DarksFIDO2.App.Controls.InspectorDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">

        <Grid>
            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BorderStrongBrush}"
                          Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NO ITEM SELECTED" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="Select a credential from the stream to inspect its cryptographic specifications."
                           Style="{StaticResource TextBodySecondary}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Active Inspector Details -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="20,18">

                    <!-- Inspector Header Card -->
                    <Border Background="{DynamicResource WellBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource TextSectionTitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedItem.SecondaryInfo}" Style="{StaticResource TextBodySecondary}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <controls:StatusPill Grid.Column="1" Text="{Binding SelectedItem.PillText}"
                                                Variant="{Binding SelectedItem.PillVariant}" />
                        </Grid>
                    </Border>

                    <!-- PASSKEY INSPECTOR SECTION -->
                    <StackPanel Visibility="{Binding SelectedItem.IsPasskey, Converter={StaticResource BoolToVis}}">
                        <!-- Cryptographic Specifications Header & Reveal/Hide Toggle -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CRYPTOGRAPHIC SPECIFICATIONS" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ToggleSecretsCommand}" Style="{StaticResource BtnMicro}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SecretsToggleText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- RP ID -->
                        <TextBlock Text="RELYING PARTY (ORIGIN)" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedItem.PasskeyData.RpId}" Style="{StaticResource TextMonoData}" />
                        </Border>

                        <!-- User Handle -->
                        <TextBlock Text="USER NAME / IDENTIFIER" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedItem.PasskeyData.UserName}" Style="{StaticResource TextMonoData}" />
                        </Border>

                        <!-- Sign Counter -->
                        <TextBlock Text="MONOTONIC SIGN COUNTER" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedItem.PasskeyData.SignCounter}" Style="{StaticResource TextMonoData}" FontWeight="SemiBold" />
                        </Border>

                        <!-- Type & Transport -->
                        <TextBlock Text="ATTACHMENT &amp; TRANSPORT" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.PasskeyData.Type}" Style="{StaticResource TextBodySecondary}" />
                                <TextBlock Text="{Binding SelectedItem.PasskeyData.Transport, StringFormat='Transport: {0}'}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Credential ID -->
                        <TextBlock Text="CREDENTIAL IDENTIFIER (BASE64URL)" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding DisplayCredentialId}" Style="{StaticResource TextMonoData}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Public Key COSE -->
                        <TextBlock Text="PUBLIC KEY (COSE SPKI)" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                            <TextBlock Text="{Binding DisplayPublicKey}" Style="{StaticResource TextMonoData}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Actions -->
                        <Button Command="{Binding TestAssertionCommand}"
                                Style="{StaticResource BtnPrimary}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLightning}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Test WebAuthn Assertion" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteItemCommand}"
                                Style="{StaticResource BtnDanger}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource StatusDangerTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Delete Passkey" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- TOTP INSPECTOR SECTION -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.IsPasskey}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- OTP Display Card (Sunken Neumorphic Well) -->
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.TotpCode}" Style="{StaticResource TextTotpDigits}"
                                           HorizontalAlignment="Center" />

                                <ProgressBar Value="{Binding SelectedItem.Progress}" Maximum="1.0" Height="4"
                                             Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                             BorderThickness="0" Margin="0,12,0,8" />

                                <TextBlock Text="{Binding SelectedItem.SecondsRemaining, StringFormat='Expires in {0} seconds'}"
                                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding CopyTotpCommand}"
                                Style="{StaticResource BtnPrimary}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Copy TOTP Code" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ACCOUNT DETAILS" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />

                        <TextBlock Text="SERVICE / ISSUER" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedItem.TotpData.Issuer}" Style="{StaticResource TextBody}" />
                        </Border>

                        <TextBlock Text="ACCOUNT IDENTIFIER" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedItem.TotpData.Account}" Style="{StaticResource TextBody}" />
                        </Border>

                        <TextBlock Text="ALGORITHM &amp; DIGITS" Style="{StaticResource TextCaption}" Margin="0,0,0,2" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedItem.TotpData.Algorithm, StringFormat='{}{0} · 6 Digits · 30s Step'}"
                                       Style="{StaticResource TextMonoData}" />
                        </Border>

                        <Button Command="{Binding DeleteItemCommand}"
                                Style="{StaticResource BtnDanger}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource StatusDangerTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Delete TOTP Account" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
