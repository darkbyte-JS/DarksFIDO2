<Window x:Class="DarksFIDO2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DarksFIDO2.App.Views"
        xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
        Title="DarksFIDO2 — Hardware Passkey &amp; WebAuthn Authenticator"
        Height="720" Width="1180" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" /> <!-- Neumorphic Custom Header & Titlebar -->
                <RowDefinition Height="*" />  <!-- Main Content Shell -->
            </Grid.RowDefinitions>

            <!-- NEUMORPHIC SYSTEM TITLEBAR & HEADER -->
            <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Brand / Title -->
                        <ColumnDefinition Width="*" />    <!-- Center Telemetry Ribbon -->
                        <ColumnDefinition Width="Auto" /> <!-- Window Controls & Lock -->
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Extruded Neumorphic Brand Icon Plate -->
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                                  BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.45" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconShield}" Fill="{DynamicResource AccentPrimaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="DARKS FIDO2" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource WellBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="v0.6.4" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Center Telemetry Ribbon (Visible when Unlocked) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                        <!-- Profile indicator -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1"
                                CornerRadius="14" Height="28" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                                  BlurRadius="4" ShadowDepth="1.5" Direction="315" Opacity="0.3" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="VAULT: " Style="{StaticResource TextCaption}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- TPM Indicator -->
                        <controls:StatusPill Text="{Binding TpmSummary}" Variant="{Binding TpmVariant}" Margin="0,0,10,0" VerticalAlignment="Center" />

                        <!-- Auto-lock Countdown -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1"
                                CornerRadius="14" Height="28" Padding="12,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                                  BlurRadius="4" ShadowDepth="1.5" Direction="315" Opacity="0.3" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource TextSecondaryBrush}"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="LOCK IN " Style="{StaticResource TextCaption}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AutoLockDisplay}" FontFamily="{StaticResource FontMonospace}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Action Controls & Emergency Lock -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tactile Lock Trigger -->
                        <Button Command="{Binding LockCommand}"
                                Style="{StaticResource BtnMicro}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,14,0"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"
                                ToolTip="Lock active vault (Ctrl+L)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Lock" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize" Width="30" Height="30" Margin="0,0,4,0"
                                Style="{StaticResource BtnMicro}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Rectangle Width="10" Height="2" Fill="{DynamicResource TextSecondaryBrush}" RadiusX="1" RadiusY="1" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Width="30" Height="30" Margin="0,0,4,0"
                                Style="{StaticResource BtnMicro}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                            <Border Width="10" Height="10" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.5" CornerRadius="1" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" Width="30" Height="30"
                                Style="{StaticResource BtnMicro}"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click" ToolTip="Close to Tray">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT SHELL -->
            <Grid Grid.Row="1">
                <!-- Gate View (Locked State) -->
                <views:GateView DataContext="{Binding GateVM}"
                                Visibility="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                <!-- Console View (Unlocked State) -->
                <views:MainConsoleView DataContext="{Binding}"
                                       Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
