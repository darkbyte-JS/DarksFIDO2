<UserControl x:Class="DarksFIDO2.App.Views.MainConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DarksFIDO2.App.Views"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Column 1: Left Navigation & Registry Explorer (230px) -->
            <ColumnDefinition Width="230" />
            <!-- Column 2: Center Master View (Flexible *) -->
            <ColumnDefinition Width="*" />
            <!-- Column 3: Contextual Inspector (340px or Collapsed) -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: LEFT NAVIGATION EXPLORER -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Profile Badge -->
                    <RowDefinition Height="*" />    <!-- Navigation Rail -->
                    <RowDefinition Height="Auto" /> <!-- System Telemetry Footer -->
                </Grid.RowDefinitions>

                <!-- Profile Header Card -->
                <Border Grid.Row="0" Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="ACTIVE VAULT PROFILE" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource TextSectionTitle}" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Rail -->
                <StackPanel Grid.Row="1" Margin="10,16">
                    <!-- Credentials -->
                    <RadioButton Command="{Binding NavCredentialsCommand}"
                                 IsChecked="{Binding IsCredentialsActive, Mode=OneWay}"
                                 GroupName="NavRail" Height="40" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconKey}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Credentials Registry" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Hardware Security -->
                    <RadioButton Command="{Binding NavHardwareCommand}"
                                 IsChecked="{Binding IsHardwareActive, Mode=OneWay}"
                                 GroupName="NavRail" Height="40" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconChip}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hardware &amp; TPM 2.0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Audit Log -->
                    <RadioButton Command="{Binding NavAuditCommand}"
                                 IsChecked="{Binding IsAuditActive, Mode=OneWay}"
                                 GroupName="NavRail" Height="40" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAudit}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Immutable Audit Log" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings -->
                    <RadioButton Command="{Binding NavSettingsCommand}"
                                 IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                 GroupName="NavRail" Height="40" Margin="0,0,0,8" Padding="12,0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Governance &amp; Settings" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- System Telemetry Footer -->
                <Border Grid.Row="2" Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="SECURITY ENCLAVE" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <controls:StatusPill HorizontalAlignment="Right" Text="{Binding TpmSummary}" Variant="{Binding TpmVariant}" />
                        </Grid>
                        <TextBlock Text="Local Native Named-Pipe: Active" Style="{StaticResource TextCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <Button Content="github.com/darkbyte-JS" Command="{Binding OpenGitHubCommand}"
                                Style="{StaticResource BtnMicro}" HorizontalAlignment="Left"
                                AutomationProperties.Name="Open GitHub repository" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- COLUMN 2: CENTER VIEW HOST -->
        <Grid Grid.Column="1">
            <!-- Credentials View -->
            <views:CredentialsListView DataContext="{Binding CredentialsVM}"
                                       Visibility="{Binding DataContext.IsCredentialsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

            <!-- Hardware View -->
            <views:HardwareView DataContext="{Binding HardwareVM}"
                                Visibility="{Binding DataContext.IsHardwareActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

            <!-- Audit View -->
            <views:AuditView DataContext="{Binding AuditVM}"
                             Visibility="{Binding DataContext.IsAuditActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

            <!-- Settings View -->
            <views:SettingsView DataContext="{Binding SettingsVM}"
                                Visibility="{Binding DataContext.IsSettingsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- COLUMN 3: CONTEXTUAL INSPECTOR DRAWER -->
        <Border Grid.Column="2" Width="340"
                Visibility="{Binding IsCredentialsActive, Converter={StaticResource BoolToVis}}">
            <controls:InspectorDrawer DataContext="{Binding CredentialsVM}" />
        </Border>
    </Grid>
</UserControl>
