<UserControl x:Class="DarksFIDO2.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="*" />    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Master Neumorphic Audit Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Filters -->
                    <ColumnDefinition Width="*" />    <!-- Search -->
                    <ColumnDefinition Width="Auto" /> <!-- Export -->
                </Grid.ColumnDefinitions>

                <!-- Filter Segmented Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="All Events" Command="{Binding FilterAllCommand}" IsChecked="True"
                                 GroupName="AuditFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="Auth Only" Command="{Binding FilterAuthCommand}"
                                 GroupName="AuditFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="Vault Ops" Command="{Binding FilterVaultCommand}"
                                 GroupName="AuditFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="Errors / Tamper" Command="{Binding FilterErrorsCommand}"
                                 GroupName="AuditFilter" Margin="0,0,12,0" Padding="12,5" />
                </StackPanel>

                <!-- Sunken Search Well -->
                <Border Grid.Column="1" Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Height="36" MaxWidth="300" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="6,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14" Stretch="Uniform" Margin="12,0,8,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentPrimaryBrush}" FontSize="13" VerticalAlignment="Center"
                                 Padding="0,2,10,2" />
                        <TextBlock Grid.Column="1" Text="Filter audit ledger..."
                                   Foreground="{DynamicResource TextDisabledBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Export Action Trigger -->
                <Button Grid.Column="2" Command="{Binding ExportSignedCsvCommand}"
                        Style="{StaticResource BtnPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAudit}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Export Signed CSV" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Audit Event DataGrid (Sculpted Neumorphic Card) -->
        <Border Grid.Row="1" Margin="20,16,20,20" Background="Transparent" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                  BlurRadius="12" ShadowDepth="3" Direction="315" Opacity="0.35" />
            </Border.Effect>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                          Style="{StaticResource StandardDataGrid}">
                    <DataGrid.Columns>
                        <!-- Timestamp (UTC) -->
                        <DataGridTextColumn Header="TIMESTAMP (UTC)" Binding="{Binding TimestampUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                            Width="170" FontFamily="{StaticResource FontMonospace}" FontSize="12" />

                        <!-- Category / Type -->
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Type}" Width="130" FontWeight="SemiBold" />

                        <!-- Outcome -->
                        <DataGridTemplateColumn Header="OUTCOME" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Outcome}" VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="Failure">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusDangerTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusDangerTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Message / Context -->
                        <DataGridTextColumn Header="EVENT MESSAGE &amp; CONTEXT" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</UserControl>
