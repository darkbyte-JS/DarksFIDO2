<UserControl x:Class="DarksFIDO2.App.Views.CredentialsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Master Neumorphic Command Toolbar -->
            <RowDefinition Height="*" />    <!-- Sculpted Credential Cards Stream -->
        </Grid.RowDefinitions>

        <!-- MASTER NEUMORPHIC COMMAND TOOLBAR (Responsive Wrap Layout) -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Filter Segmented Pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <RadioButton Content="All Items" Command="{Binding FilterAllCommand}" IsChecked="True"
                                 GroupName="CredFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="Passkeys" Command="{Binding FilterPasskeysCommand}"
                                 GroupName="CredFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="TOTP 2FA" Command="{Binding FilterTotpCommand}"
                                 GroupName="CredFilter" Margin="0,0,6,0" Padding="12,5" />
                    <RadioButton Content="TPM Silicon" Command="{Binding FilterHardwareCommand}"
                                 GroupName="CredFilter" Margin="0,0,0,0" Padding="12,5" />
                </StackPanel>

                <!-- Sunken Search Well -->
                <Border Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Height="36" Width="220"
                        VerticalAlignment="Center" Margin="0,4,12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14" Stretch="Uniform" Margin="10,0,6,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentPrimaryBrush}" FontSize="13" VerticalAlignment="Center"
                                 Padding="0,2,10,2" />
                        <TextBlock Grid.Column="1" Text="Search credentials... (/)"
                                   Foreground="{DynamicResource TextDisabledBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Tactical Action Triggers -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <Button Command="{Binding NewPasskeyCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Passkey" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewTotpManualCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="TOTP" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SnipeScreenQrCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEye}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Snipe QR" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportQrFileCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAudit}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Import Image" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenPasswordGeneratorCommand}" Style="{StaticResource BtnSecondary}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconKey}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Password Gen" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- SCULPTED CREDENTIAL CARDS STREAM -->
        <Grid Grid.Row="1">
            <!-- Main Credential Cards ListBox -->
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="20,16"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ShadowPlate" Background="Transparent" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="CardShadow"
                                                              Color="{DynamicResource ShadowAmbientColor}"
                                                              BlurRadius="8" ShadowDepth="2.5" Direction="315" Opacity="0.35" />
                                        </Border.Effect>
                                        <Border x:Name="CardBorder"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="14,12"
                                                SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CardTrans" X="0" Y="0" />
                                            </Border.RenderTransform>
                                            <ContentPresenter />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Sunken concave active well -->
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource WellBackgroundBrush}" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="1" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- Emblem Well -->
                                <ColumnDefinition Width="*" />    <!-- Name, Account & Security Tags -->
                                <ColumnDefinition Width="Auto" /> <!-- Interactive Action Capsule -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Emblem Well (Concave recessed badge) -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                    Background="{DynamicResource WellBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Grid>
                                    <!-- Passkey Emblem -->
                                    <Path Data="{StaticResource IconKey}" Fill="{DynamicResource AccentPrimaryBrush}"
                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsPasskey, Converter={StaticResource BoolToVis}}" />
                                    <!-- TOTP Emblem -->
                                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource StatusSuccessTextBrush}"
                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasskey}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Border>

                            <!-- 2. Credential Info & Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center" />
                                    <controls:StatusPill Margin="10,0,0,0" Text="{Binding PillText}" Variant="{Binding PillVariant}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding SecondaryInfo}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />

                                <TextBlock Text="{Binding TypeDisplay}" Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- 3. Interactive Action Capsule -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Passkey Action: Test Assertion -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsPasskey, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding DataContext.TestAssertionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnMicro}" Height="30" Padding="10,4"
                                            ToolTip="Test assertion signature ceremony">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconLightning}" Fill="{DynamicResource AccentPrimaryBrush}"
                                                  Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Test Assertion" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- TOTP Action: Live Digits Display & Copy Button -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasskey}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Recessed Monospace Digit Well -->
                                    <Border Background="{DynamicResource WellBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="10,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TotpCode}" FontFamily="{StaticResource FontMonospace}"
                                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Time Countdown Badge -->
                                    <Border Background="{DynamicResource WellBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SecondsRemaining, StringFormat='{}{0}s'}"
                                                   FontFamily="{StaticResource FontMonospace}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Tactile Copy Trigger -->
                                    <Button Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnMicro}" Height="30" Padding="10,4"
                                            ToolTip="Copy 2FA code to clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}"
                                                  Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Copy" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                <Setter Property="Text" Value="Copied!" />
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State Display -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="64" Height="64" CornerRadius="16"
                        Background="{DynamicResource WellBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BorderStrongBrush}"
                          Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NO CREDENTIALS MATCH" Style="{StaticResource TextSectionTitle}"
                           HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="No credentials registered in this category or matching your search filter."
                           Style="{StaticResource TextBodySecondary}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
