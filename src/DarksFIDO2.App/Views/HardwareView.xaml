<UserControl x:Class="DarksFIDO2.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel MaxWidth="920" HorizontalAlignment="Left">

                <!-- View Title & Refresh -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="HARDWARE SECURITY &amp; TPM 2.0" Style="{StaticResource TextHeaderLarge}" FontWeight="Bold" />
                        <TextBlock Text="Hardware-isolated root of trust, PCR measurement banks, and platform authenticators."
                                   Style="{StaticResource TextBodySecondary}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                            Style="{StaticResource BtnSecondary}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh Diagnostics" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Diagnostics Summary Cards (Tactile Elevated Plates) -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: TPM State -->
                    <Border Grid.Column="0" CornerRadius="12" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                              BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                        </Border.Effect>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="TPM 2.0 SILICON" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                    <controls:StatusPill HorizontalAlignment="Right" Text="{Binding TpmPillText}" Variant="{Binding TpmPillVariant}" />
                                </Grid>
                                <TextBlock Text="{Binding Status.Manufacturer}" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Status.Detail}" Style="{StaticResource TextBodySecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Card 2: Platform Authenticator -->
                    <Border Grid.Column="2" CornerRadius="12" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                              BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                        </Border.Effect>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="PLATFORM AUTHENTICATOR" Style="{StaticResource TextCaption}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding PlatformAuthStatus}" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="Biometric &amp; Windows Hello integration" Style="{StaticResource TextBodySecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Card 3: WebAuthn API -->
                    <Border Grid.Column="4" CornerRadius="12" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                              BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                        </Border.Effect>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="WEBAUTHN WIN32 SUBSYSTEM" Style="{StaticResource TextCaption}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding WebAuthnApiVersion, StringFormat='API Level {0}'}" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="Native webauthn.dll broker bridge" Style="{StaticResource TextBodySecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- PCR Banks Section -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="PLATFORM CONFIGURATION REGISTERS (PCR BANKS 0-7)" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Pre-boot integrity metrics and cryptographic measurements sealed by silicon." Style="{StaticResource TextBodySecondary}" Margin="0,0,0,16" />

                            <ItemsControl ItemsSource="{Binding PcrRegisters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WellBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Index, StringFormat='PCR {0:D2}'}" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource FontMonospace}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DigestHex}" FontFamily="{StaticResource FontMonospace}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Hardware Keys Section -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TPM-BOUND HARDWARE KEYS" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="Keys sealed to the hardware Storage Root Key (SRK) with export protection." Style="{StaticResource TextBodySecondary}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding DeriveTestKeyCommand}"
                                        Style="{StaticResource BtnPrimary}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Derive Test Key" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border CornerRadius="10" Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding TpmKeys}" Style="{StaticResource StandardDataGrid}" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KEY NAME" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="ALGORITHM" Binding="{Binding Algorithm}" Width="1.5*" />
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding AttestationStatus}" Width="1.5*" />
                                        <DataGridTextColumn Header="CREATED (UTC)" Binding="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="*" />
                                        <DataGridTemplateColumn Header="ACTIONS" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DeleteTpmKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BtnDanger}"
                                                            Height="28" Padding="8,2"
                                                            ToolTip="Delete TPM Key">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconTrash}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Delete" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
