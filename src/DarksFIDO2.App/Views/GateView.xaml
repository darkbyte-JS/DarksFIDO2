<UserControl x:Class="DarksFIDO2.App.Views.GateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DarksFIDO2.App.Controls"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!-- Central Sculpted Neumorphic Security Card (Themesberg sign-in aesthetic) -->
        <Border Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="18" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                  BlurRadius="24" ShadowDepth="8" Direction="315" Opacity="0.5" />
            </Border.Effect>
            <Border Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderHighlightBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="38,36"
                    SnapsToDevicePixels="True">

                <StackPanel>
                    <!-- Brand / Emblem (Extruded Neumorphic Circle) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,26">
                        <Border Width="68" Height="68" CornerRadius="34"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                                  BlurRadius="10" ShadowDepth="4" Direction="315" Opacity="0.45" />
                            </Border.Effect>
                            <Path Data="{StaticResource IconShield}" Fill="{DynamicResource AccentPrimaryBrush}"
                                  Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="DARKS FIDO2" Style="{StaticResource TextHeaderLarge}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" />
                        <TextBlock Text="HARDENED WEBAUTHN &amp; HARDWARE PASSKEY VAULT"
                                   Style="{StaticResource TextCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- INITIALIZE FIRST VAULT STATE (When No Profiles Exist) -->
                    <StackPanel Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource WellBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconKey}" Fill="{DynamicResource AccentPrimaryBrush}"
                                      Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="NO VAULT DETECTED" FontWeight="SemiBold" Style="{StaticResource TextSectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Create your first hardware-backed encrypted vault profile to begin storing passkeys and 2FA credentials."
                                           Style="{StaticResource TextBodySecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding CreateProfileCommand}"
                                Style="{StaticResource BtnPrimary}" Height="42" FontSize="13" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Create First Profile" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- LOGIN STATE (When Profiles Exist) -->
                    <StackPanel Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                        <!-- Profile Selection (Neumorphic Account Menu) -->
                        <TextBlock Text="SELECT VAULT PROFILE" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ProfileCombo" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  Style="{StaticResource StandardComboBox}" Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                Background="{DynamicResource WellBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconUser}" Fill="{DynamicResource AccentPrimaryBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Visibility="{Binding KeyfileRequired, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource WellBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="2FA KEYFILE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Master PIN -->
                        <TextBlock Text="MASTER PIN / PASSPHRASE" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />
                        <controls:PinBox x:Name="MasterPinBox" Margin="0,0,0,16" />

                        <!-- Keyfile Status (if required) -->
                        <StackPanel Visibility="{Binding SelectedProfile.KeyfileRequired, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,16">
                            <TextBlock Text="DUAL-FACTOR COMPANION KEYFILE (.DFKEY)" Style="{StaticResource TextCaption}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding KeyfilePath}" IsReadOnly="True" Style="{StaticResource StandardTextBox}" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding SelectKeyfileCommand}" Style="{StaticResource BtnSecondary}" Height="36" />
                            </Grid>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusDangerTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Unlock Button -->
                        <Button x:Name="UnlockBtn" Style="{StaticResource BtnPrimary}"
                                Height="42" Margin="0,4,0,20" Click="UnlockBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUnlock}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Unlock Vault" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,16" />

                        <!-- Bottom Actions -->
                        <Grid>
                            <Button Command="{Binding CreateProfileCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentPrimaryBrush}"
                                    Cursor="Hand" HorizontalAlignment="Left" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource AccentPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="New Profile" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RecoveryCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Cursor="Hand" HorizontalAlignment="Right" FontSize="12">
                                <TextBlock Text="Emergency Recovery" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
