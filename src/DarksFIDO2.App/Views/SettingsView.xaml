<UserControl x:Class="DarksFIDO2.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- View Title -->
                <TextBlock Text="VAULT GOVERNANCE &amp; SETTINGS" Style="{StaticResource TextHeaderLarge}" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Security parameters, encrypted backups, keyfile rotation, and profile lifecycle."
                           Style="{StaticResource TextBodySecondary}" Margin="0,0,0,24" />

                <!-- Profile Identity Card -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROFILE IDENTITY" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Profile Name" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentProfileName}" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Profile GUID" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource WellBackgroundBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentProfileId}" Style="{StaticResource TextMonoData}" />
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Companion Keyfile" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding KeyfileRequired, StringFormat='Enforced: {0}'}" Style="{StaticResource TextBodySecondary}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Security Preferences Card -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="SECURITY PREFERENCES" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,18" />

                            <!-- Auto-lock Timeout -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Inactivity Auto-Lock Timeout" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Automatically locks vault after idle duration (measured via Win32 GetLastInputInfo)."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AutoLockMinutes, StringFormat='{}{0} Minutes'}" Style="{StaticResource TextCaption}"
                                               HorizontalAlignment="Right" Margin="0,0,0,6" />
                                    <Slider Minimum="1" Maximum="30" Value="{Binding AutoLockMinutes}" TickFrequency="5" IsSnapToTickEnabled="False" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,18" />

                            <!-- Visual Theme Toggle -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Dark Neumorphic Theme" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Tactile dual-light Soft UI with directional specular highlights."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkTheme}" Content="Dark Mode"
                                          Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,18" />

                            <!-- Windows Hello Integration -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows Hello Biometric Support" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Enable TPM-backed platform passkey registration and verification."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1" IsChecked="{Binding WindowsHelloEnabled}" Content="Enabled"
                                          Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Cryptographic Governance Operations Card -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.35" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="CRYPTOGRAPHIC MAINTENANCE &amp; BACKUP" Style="{StaticResource TextSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <!-- Keyfile Rotation -->
                            <Grid Margin="0,10,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rotate Master Companion Keyfile" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Generates a new 64-byte CSPRNG keyfile and atomically re-encrypts vault master key."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Rotate Keyfile" Command="{Binding RotateKeyfileCommand}"
                                        Style="{StaticResource BtnSecondary}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14" />

                            <!-- Encrypted Backup -->
                            <Grid Margin="0,10,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Export Encrypted Backup (.dfb1)" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Create a passphrase-protected AES-256-GCM container of all credentials and keys."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export Backup" Command="{Binding CreateBackupCommand}"
                                        Style="{StaticResource BtnSecondary}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14" />

                            <!-- Restore Backup -->
                            <Grid Margin="0,10,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Restore from Backup Container" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                    <TextBlock Text="Restore credentials and settings from an existing encrypted .dfb1 file."
                                               Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restore Backup" Command="{Binding RestoreBackupCommand}"
                                        Style="{StaticResource BtnSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Danger Zone Card -->
                <Border CornerRadius="12" Background="Transparent" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowAmbientColor}"
                                          BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.3" />
                    </Border.Effect>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusDangerBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DANGER ZONE: DELETE PROFILE" FontWeight="SemiBold" Foreground="{DynamicResource StatusDangerTextBrush}" Style="{StaticResource TextBody}" />
                                <TextBlock Text="Permanently purges the active profile, vault records, and hardware-backed TPM keys."
                                           Style="{StaticResource TextBodySecondary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Delete Profile" Command="{Binding DeleteProfileCommand}"
                                    Style="{StaticResource BtnDanger}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
