<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DarksFIDO2-Setup</AssemblyName>
    <RootNamespace>DarksFIDO2.Setup</RootNamespace>
    <Version>0.6.1</Version>
    <ApplicationIcon>..\DarksFIDO2.App\Assets\DarksFIDO2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup Condition="Exists('Payload\DarksFIDO2-Portable.zip')">
    <EmbeddedResource Include="Payload\DarksFIDO2-Portable.zip" LogicalName="DarksFIDO2.Payload.zip" />
    <EmbeddedResource Include="Payload\DarksFIDO2.Provider.msix" LogicalName="DarksFIDO2.Provider.msix" Condition="Exists('Payload\DarksFIDO2.Provider.msix')" />
  </ItemGroup>
</Project>
